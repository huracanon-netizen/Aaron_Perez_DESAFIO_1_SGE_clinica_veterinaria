<odoo>
<!--Con record creas un registro en ODOO-->
  <record id="view_duenyo_form" model="ir.ui.view"> <!--indica que lo que creas es una vista de Odoo.-->
    <field name="name">clinica_vet.duenyo.form</field>
    <field name="model">clinica_vet.duenyo</field>
    <field name="arch" type="xml"><!--aquí dentro va el XML de la vista.-->
      <form string="Ficha del dueño">
        <sheet><!--El sheet es para que los campos se vean en una hoja-->
          <group><!--El group es para agrupar los campos en la vista-->
            <field name="nombre"/>
            <field name="apellidos"/><!-- El field es cada columna-->
          </group>
          <group>
            <field name="telefono"/>
            <field name="email"/>
          </group>
          <group>
            <field name="fecha_alta"/>
            <field name="es_cliente_habitual"/>
            <field name="peso_total"/>
            <field name="notas"/>
          </group>
          <!--Aqui salen las mascotas del dueño, que es el campo One2many-->
          <field name="mascota_ids"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_duenyo_list" model="ir.ui.view">
    <field name="name">clinica_vet.duenyo.list</field>
    <field name="model">clinica_vet.duenyo</field>
    <field name="arch" type="xml">
      <list string="Lista de dueños">
        <field name="nombre"/>
        <field name="apellidos"/>
        <field name="telefono"/>
        <field name="email"/>
        <field name="es_cliente_habitual"/>
      </list>
    </field>
  </record>

  <!--La vista search es la barra de busqueda de arriba. Los field son por lo que se puede buscar,
  los filter con domain son los filtros y los filter con group_by son las agrupaciones-->
  <record id="view_duenyo_search" model="ir.ui.view">
    <field name="name">clinica_vet.duenyo.search</field>
    <field name="model">clinica_vet.duenyo</field>
    <field name="arch" type="xml">
      <search string="Buscar">
        <field name="nombre"/>
        <field name="apellidos"/>
        <field name="telefono"/>
        <filter string="Clientes habituales" name="habituales" domain="[('es_cliente_habitual','=',True)]"/>
        <filter string="Por fecha de alta" name="grupo_fecha_alta" context="{'group_by':'fecha_alta'}"/>
      </search>
    </field>
  </record>

  <record id="action_duenyo" model="ir.actions.act_window">
    <field name="name">Dueños</field>
    <field name="res_model">clinica_vet.duenyo</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_duenyo_list"/>
  </record>

<!--El menuitem es para crear un menú en Odoo-->
  <menuitem id="menu_clinica_root" name="Orivetia"/> 
  <menuitem id="menu_duenyos"
            parent="menu_clinica_root"
            name="Dueños"
            action="action_duenyo"/>

</odoo>