<odoo>

  <record id="view_duenyo_form" model="ir.ui.view">
    <field name="name">clinica_vet.duenyo.form</field>
    <field name="model">clinica_vet.duenyo</field>
    <field name="arch" type="xml">
      <form string="Ficha del dueño">
        <sheet>
          <group>
            <field name="nombre"/>
            <field name="apellidos"/>
          </group>
          <group>
            <field name="telefono"/>
            <field name="email"/>
          </group>
          <group>
            <field name="fecha_alta"/>
            <field name="es_cliente_habitual"/>
            <field name="peso_total"/>
            <field name="notas"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_duenyo_list" model="ir.ui.view">
    <field name="name">clinica_vet.duenyo.list</field>
    <field name="model">clinica_vet.duenyo</field>
    <field name="arch" type="xml">
      <list string="Lista de dueños">
        <field name="nombre"/>
        <field name="apellidos"/>
        <field name="telefono"/>
        <field name="email"/>
        <field name="es_cliente_habitual"/>
      </list>
    </field>
  </record>

  <record id="action_duenyo" model="ir.actions.act_window">
    <field name="name">Dueños</field>
    <field name="res_model">clinica_vet.duenyo</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_duenyo_list"/>
  </record>

  <menuitem id="menu_clinica_root" name="Orivetia"/>
  <menuitem id="menu_duenyos"
            parent="menu_clinica_root"
            name="Dueños"
            action="action_duenyo"/>

</odoo>