<odoo>

  <record id="view_tratamiento_form" model="ir.ui.view">
    <field name="name">clinica_vet.tratamiento.form</field>
    <field name="model">clinica_vet.tratamiento</field>
    <field name="arch" type="xml">
      <form string="Ficha del tratamiento">
        <sheet>
          <group>
            <field name="name"/>
            <field name="categoria"/>
          </group>
          <group>
            <field name="precio"/>
            <field name="duracion_minutos"/>
          </group>
          <group>
            <field name="fecha_alta"/>
            <field name="activo"/>
            <field name="descripcion"/>
          </group>
          <field name="consulta_ids"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_tratamiento_list" model="ir.ui.view">
    <field name="name">clinica_vet.tratamiento.list</field>
    <field name="model">clinica_vet.tratamiento</field>
    <field name="arch" type="xml">
      <list string="Lista de tratamientos">
        <field name="name"/>
        <field name="categoria"/>
        <field name="precio"/>
        <field name="duracion_minutos"/>
        <field name="activo"/>
      </list>
    </field>
  </record>

  <!--La vista search es la barra de busqueda de arriba. Los field son por lo que se puede buscar,
  los filter con domain son los filtros y los filter con group_by son las agrupaciones-->
  <record id="view_tratamiento_search" model="ir.ui.view">
    <field name="name">clinica_vet.tratamiento.search</field>
    <field name="model">clinica_vet.tratamiento</field>
    <field name="arch" type="xml">
      <search string="Buscar">
        <field name="name"/>
        <field name="categoria"/>
        <filter string="Disponibles" name="disponibles" domain="[('activo','=',True)]"/>
        <filter string="Por categoría" name="grupo_categoria" context="{'group_by':'categoria'}"/>
      </search>
    </field>
  </record>

  <record id="action_tratamiento" model="ir.actions.act_window">
    <field name="name">Tratamientos</field>
    <field name="res_model">clinica_vet.tratamiento</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_tratamiento_list"/>
  </record>

  <menuitem id="menu_tratamientos"
            parent="menu_clinica_root"
            name="Tratamientos"
            action="action_tratamiento"/>

</odoo>