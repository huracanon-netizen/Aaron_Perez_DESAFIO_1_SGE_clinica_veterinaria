<odoo>

  <record id="view_mascota_form" model="ir.ui.view">
    <field name="name">clinica_vet.mascota.form</field>
    <field name="model">clinica_vet.mascota</field>
    <field name="arch" type="xml">
      <form string="Ficha de la mascota">
        <sheet>
          <group>
            <field name="nombre"/>
            <field name="duenyo_id"/>
          </group>
          <group>
            <field name="especie"/>
            <field name="raza"/>
            <field name="peso"/>
          </group>
          <group>
            <field name="fecha_nacimiento"/>
            <field name="edad"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_mascota_list" model="ir.ui.view">
    <field name="name">clinica_vet.mascota.list</field>
    <field name="model">clinica_vet.mascota</field>
    <field name="arch" type="xml">
      <list string="Lista de mascotas">
        <field name="nombre"/>
        <field name="duenyo_id"/>
        <field name="especie"/>
        <field name="raza"/>
        <field name="edad"/>
        <field name="peso"/>
      </list>
    </field>
  </record>

  <record id="action_mascota" model="ir.actions.act_window">
    <field name="name">Mascotas</field>
    <field name="res_model">clinica_vet.mascota</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_mascota_list"/>
  </record>

  <menuitem id="menu_mascotas"
            parent="menu_clinica_root"
            name="Mascotas"
            action="action_mascota"/>

</odoo>