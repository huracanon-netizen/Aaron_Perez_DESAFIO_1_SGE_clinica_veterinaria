<odoo>

  <record id="view_mascota_form" model="ir.ui.view">
    <field name="name">clinica_vet.mascota.form</field>
    <field name="model">clinica_vet.mascota</field>
    <field name="arch" type="xml">
      <form string="Ficha de la mascota">
        <sheet>
          <group>
            <field name="nombre"/>
            <field name="duenyo_id"/>
          </group>
          <group>
            <field name="especie"/>
            <field name="raza"/>
            <field name="peso"/>
          </group>
          <group>
            <field name="fecha_nacimiento"/>
            <field name="edad"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_mascota_list" model="ir.ui.view">
    <field name="name">clinica_vet.mascota.list</field>
    <field name="model">clinica_vet.mascota</field>
    <field name="arch" type="xml">
      <list string="Lista de mascotas">
        <field name="nombre"/>
        <field name="duenyo_id"/>
        <field name="especie"/>
        <field name="raza"/>
        <field name="edad"/>
        <field name="peso"/>
      </list>
    </field>
  </record>

  <!--La vista search es la barra de busqueda de arriba. Los field son por lo que se puede buscar,
  los filter con domain son los filtros y los filter con group_by son las agrupaciones-->
  <record id="view_mascota_search" model="ir.ui.view">
    <field name="name">clinica_vet.mascota.search</field>
    <field name="model">clinica_vet.mascota</field>
    <field name="arch" type="xml">
      <search string="Buscar">
        <field name="nombre"/>
        <field name="duenyo_id"/>
        <field name="raza"/>
        <filter string="Perros" name="perros" domain="[('especie','=','perro')]"/>
        <filter string="Gatos" name="gatos" domain="[('especie','=','gato')]"/>
        <filter string="Por especie" name="grupo_especie" context="{'group_by':'especie'}"/>
        <filter string="Por dueño" name="grupo_duenyo" context="{'group_by':'duenyo_id'}"/>
      </search>
    </field>
  </record>

  <record id="action_mascota" model="ir.actions.act_window">
    <field name="name">Mascotas</field>
    <field name="res_model">clinica_vet.mascota</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_mascota_list"/>
  </record>
    <record id="view_mascota_form" model="ir.ui.view">
    <field name="name">clinica_vet.mascota.form</field>
    <field name="model">clinica_vet.mascota</field>
    <field name="arch" type="xml">
      <form string="Ficha de la mascota">
        <sheet>
          <group>
            <field name="nombre"/>
            <field name="duenyo_id"/>
          </group>
          <group>
            <field name="especie"/>
            <field name="raza"/>
            <field name="peso"/>
          </group>
          <group>
            <field name="fecha_nacimiento"/>
            <field name="edad"/>
          </group>
          <group>
            <field name="foto" widget="image"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <menuitem id="menu_mascotas"
            parent="menu_clinica_root"
            name="Mascotas"
            action="action_mascota"/>

</odoo>